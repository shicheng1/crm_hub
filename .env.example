# Database
MYSQL_DATABASE=order_approval
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_USERNAME=order_app
MYSQL_PASSWORD=change_me_order_app_password
MYSQL_URL=jdbc:mysql://mysql:3306/order_approval?useUnicode=true&characterEncoding=utf8&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=order_app
RABBITMQ_PASSWORD=change_me_rabbitmq_password
RABBITMQ_VHOST=/
RABBITMQ_PREFETCH=50
MQ_ENABLED=true

# JWT: production must use at least 32 bytes random string
JWT_SECRET=change_me_to_a_random_32_bytes_minimum_secret
JWT_EXPIRE_HOURS=24

# JVM
JAVA_OPTS=-Xms256m -Xmx512m -XX:+UseG1GC -XX:MaxGCPauseMillis=200
LOG_FILE=/opt/app/logs/order-approval.log
